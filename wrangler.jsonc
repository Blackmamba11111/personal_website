{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    /* 所有请求都先过 Worker：这样安全响应头（nosniff / referrer-policy /
       permissions-policy）能覆盖整站，而不只是 /api/*。
       之前写成 ["/api/*"]，非接口路径会被静态资源层直接返回，Worker 的
       securityWrapped 根本不会执行，三个安全头在线上就消失了。 */
    "run_worker_first": true,
    /* 未匹配到文件时返回仓库根目录的 404.html（否则是空白 404） */
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inspection_ledger",
      "database_id": "af5622e3-6646-47e9-8cb8-63beef4addb3"
    }
  ],
  /* 部署版本标识：用于给 HTML 生成 ETag。
     Workers 静态资源本身不返回 ETag/Last-Modified，配合 cache-control: no-cache
     会导致浏览器每次打开都完整重下整个页面（看板 600 KB 级别）。
     有了版本 ID 作为强校验器，未变更时只回 304，二次打开几乎不消耗流量。 */
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
